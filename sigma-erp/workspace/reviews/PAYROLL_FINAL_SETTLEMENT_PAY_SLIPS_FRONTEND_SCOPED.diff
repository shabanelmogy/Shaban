    const restore = freezeFormState(this.form, this.destroyRef); this.loadingService(true);
    this.service.getRun(id).pipe(takeUntilDestroyed(this.destroyRef), finalize(() => { this.loadingRun.set(false); this.loadingService(false); this.restore(restore); })).subscribe({
      next: r => {
        if (!r.isSuccess) { this.loadFailed.set(true); this.error.set(r.message || 'finalSettlementProcess.loadError'); return; }
        const run = r.entity;
        if (!run || run.id !== id || run.type !== 'FinalSettlement' || !run.staffId || !run.finalSettlement ||
            run.rows.length !== 1 || run.rows[0].staffId !== run.staffId || run.finalSettlement.inputs.lastWorkingDay.slice(0, 7) !== run.period) {
          this.rejectContext('finalSettlementProcess.routeMismatch'); return;
        }
        this.apply(run);
      },
      error: e => { this.loadFailed.set(true); this.error.set(apiErrorMessage(e, 'finalSettlementProcess.loadError')); },
    });
  }
  private apply(run: PayrollRun): void { this.loadFailed.set(false); this.inputsChanged.set(false); this.preview.set(run); this.historical.set(null); this.acceptedStaffId.set(run.staffId); this.ensureStaff(run); this.patchSnapshot(run); this.form.markAsPristine(); this.loadRevisions(run); }
