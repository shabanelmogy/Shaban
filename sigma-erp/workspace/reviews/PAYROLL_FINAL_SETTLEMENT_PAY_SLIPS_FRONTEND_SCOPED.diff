  private patchSnapshot(run: PayrollRun): void { this.inputsChanged.set(false); const s = run.finalSettlement!; this.form.patchValue({ staffId: run.staffId, lastWorkingDay: toPickerDate(s.inputs.lastWorkingDay), joiningOrRejoiningDate: toPickerDate(s.inputs.joiningOrRejoiningDate), salaryProrationBasis: s.inputs.salaryProrationBasis, leaveDaysRemaining: s.inputs.leaveDaysRemaining, leaveSalaryBasis: s.inputs.leaveSalaryBasis, ticketQuota: s.inputs.ticketQuota, ticketQuotaPeriodYears: s.inputs.ticketQuotaPeriodYears, ticketPrice: s.inputs.ticketPrice, ticketEligibilityPercent: s.inputs.ticketEligibilityPercent, gratuityDays: s.inputs.gratuityDays, gratuitySalaryBasis: s.inputs.gratuitySalaryBasis, revision: null }, { emitEvent: false }); }
  private rejectContext(message: string): void { this.contextRejected = true; this.readOnly.set(true); this.form.disable({ emitEvent: false }); this.error.set(message); }
  private loadingService(start: boolean): void { start ? this.loading.startLoading() : this.loading.endLoading(); }
  private returnParams(): Record<string, unknown> { const result: Record<string, unknown> = {}; for (const key of Object.keys(this.activatedRoute.snapshot.queryParams)) if (!['runId', 'mode', 'returnTo'].includes(key)) result[key] = this.activatedRoute.snapshot.queryParams[key]; return result; }
