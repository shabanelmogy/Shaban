  private loadStaff(): void { if (this.staffLoading()) return; this.staffLoading.set(true); this.staffError.set(''); this.service.staff().pipe(takeUntilDestroyed(this.destroyRef), finalize(() => this.staffLoading.set(false))).subscribe({ next: r => { if (!r.isSuccess) { this.staffError.set(r.message || 'finalSettlementProcess.staffLoadError'); return; } const saved = this.staffOptions().find(x => x.id === this.preview()?.staffId); const rows = r.entities ?? []; this.staffOptions.set(saved && !rows.some(x => x.id === saved.id) ? [saved, ...rows] : rows); }, error: e => this.staffError.set(apiErrorMessage(e, 'finalSettlementProcess.staffLoadError')) }); }
