  private request(): SettlementCalculateRequest | null { const finalSettlement = this.inputs(); if (!finalSettlement) return null; return { period: finalSettlement.lastWorkingDay.slice(0, 7), type: 'FinalSettlement', staffId: this.form.controls.staffId.getRawValue()!, finalSettlement }; }
