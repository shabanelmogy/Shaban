import { Injectable } from '@angular/core';
import { Observable } from 'rxjs';

import { Result } from 'src/app/modules/shared/models/result';
import { Results } from 'src/app/modules/shared/models/results';
import { BaseService } from 'src/app/modules/shared/service/base-service.service';
import { environment } from 'src/environments/environment';
import {
  FinalSettlementStaffOption, PayrollCalculateRequest, PayrollRevisionSummary, PayrollRun,
  PayrollRunLog, PayrollSaveRequest,
} from '../../PayrollProcess/models/payroll-run';

@Injectable({ providedIn: 'root' })
export class FinalSettlementService extends BaseService {
  private readonly options = { headers: { 'X-Skip-Error-Interceptor': 'true' } };
  constructor() { super('PayrollRuns', environment.baseUrl); }
  staff(): Observable<Results<FinalSettlementStaffOption>> {
    return this.http.get<Results<FinalSettlementStaffOption>>(`${this.baseUrl}PayrollRuns/settlement-staff`, this.options);
  }
  calculate(request: PayrollCalculateRequest): Observable<Result<PayrollRun>> {
    return this.http.post<Result<PayrollRun>>(`${this.baseUrl}PayrollRuns/calculate`, request,
      { headers: { ...this.options.headers, 'X-Skip-Success-Toast': 'true' } });
  }
  save(request: PayrollSaveRequest): Observable<Result<PayrollRun>> {
    return this.http.post<Result<PayrollRun>>(`${this.baseUrl}PayrollRuns`, request, this.options);
  }
  getRun(id: number): Observable<Result<PayrollRun>> {
    return this.http.get<Result<PayrollRun>>(`${this.baseUrl}PayrollRuns/${id}`, this.options);
  }
  revisions(id: number): Observable<Result<PayrollRevisionSummary[]>> {
    return this.http.get<Result<PayrollRevisionSummary[]>>(`${this.baseUrl}PayrollRuns/${id}/revisions`, this.options);
  }
  revision(id: number, revision: number): Observable<Result<PayrollRun>> {
    return this.http.get<Result<PayrollRun>>(`${this.baseUrl}PayrollRuns/${id}/revisions/${revision}`, this.options);
  }
  logs(id: number): Observable<Result<PayrollRunLog[]>> {
    return this.http.get<Result<PayrollRunLog[]>>(`${this.baseUrl}PayrollRuns/${id}/logs`, this.options);
  }
}


