    <Compile Include="$(SecuritySource)\Models\ApplicationUser.cs" Link="Owners\ApplicationUser.cs" />
    <Compile Include="$(SecuritySource)\Models\IdentityTenant.cs" Link="Owners\IdentityTenant.cs" />
    <Compile Include="$(SecuritySource)\DataAccess\ApplicationDbContext.cs" Link="Owners\ApplicationDbContext.cs" />
    <Compile Include="$(SecuritySource)\DataAccess\IdentityTenantConfiguration.cs" Link="Owners\IdentityTenantConfiguration.cs" />
    <Compile Include="$(SecuritySource)\Services\SubscriptionCodeResolver.cs" Link="Owners\SubscriptionCodeResolver.cs" />
