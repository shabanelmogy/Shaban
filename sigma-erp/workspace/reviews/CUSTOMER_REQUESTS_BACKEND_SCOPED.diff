+        protected override async Task<Result> UpdateCoreAsync(CustomerRequestUpdateVM vm)
+        {
+            var entity = await UnitOfWork.Repository.FindByIdAsync<CustomerRequest>(vm.Id);
+            if (entity == null)
+                return BusinessFailure("FailedToFound", StatusCodes.Status404NotFound);
+            if (await InvalidInputAsync(vm, vm.Id) is { } invalid)
+                return invalid;
+            if (await InvalidCustomerAsync(vm.CustomerId) is { } invalidCustomer)
+                return invalidCustomer;
+
+            // Track only editable inputs; a concurrent Close must never be reverted by a full-row update.
+            Mapper.Map(vm, entity);
+            return await SaveUpdateAsync(entity);
+        }
