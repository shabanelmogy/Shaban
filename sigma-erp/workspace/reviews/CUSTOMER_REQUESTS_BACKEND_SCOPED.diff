+        private async Task<Result?> InvalidCustomerAsync(int? customerId, CancellationToken cancellationToken = default)
+        {
+            if (customerId.HasValue && !await UnitOfWork.Repository.ExistsAsync<Partner>(
+                    x => x.Id == customerId.Value &&
+                         (x.PartnerType == PartnerType.Individual || x.PartnerType == PartnerType.Company),
+                    cancellationToken: cancellationToken))
+                return BusinessFailure("CustomerRequestCustomerInvalid");
+            return null;
+        }
+
+        public async Task<Result> CloseAsync(int id, CancellationToken cancellationToken)
+        {
+            var entity = await UnitOfWork.Repository.FindByIdAsync<CustomerRequest>(id, cancellationToken);
+            if (entity == null)
+                return BusinessFailure("FailedToFound", StatusCodes.Status404NotFound);
+            if (entity.Status == CustomerRequestStatus.Closed)
+                return new Result { IsSuccess = true, Id = entity.Id, Message = LocalizeMessage("CustomerRequestClosed") };
+            if (entity.Status != CustomerRequestStatus.Open)
+                return BusinessFailure("CustomerRequestCloseInvalidState");
+
+            entity.Close();
+            var saved = await UnitOfWork.SaveChangesAsync(cancellationToken);
+            return new Result
+            {
+                IsSuccess = saved,
+                Id = entity.Id,
+                Message = LocalizeMessage(saved ? "CustomerRequestClosed" : "FailedToUpdate")
+            };
