+            var detail = await UnitOfWork.Repository.Query<CustomerRequest>(x => x.Id == id)
+                .AsNoTracking()
+                .ProjectTo<CustomerRequestDetailVM>(Mapper.ConfigurationProvider)
+                .FirstOrDefaultAsync();
+            return detail == null
