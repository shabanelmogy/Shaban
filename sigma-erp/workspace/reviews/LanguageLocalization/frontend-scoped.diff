+        if (!response.isSuccess) {
+          this.actionError.set(response.message || 'languageManagement.errors.save');
+          return;
+        }
+        this.outcome.set('languageManagement.stored');
+        this.refreshAppliedList();
+        this.retryRuntime();
+      },
+      error: error => this.actionError.set(apiErrorMessage(error, 'languageManagement.errors.save')),
+    });
+  }
+
+  retryRuntime(): void {
+    if (this.refreshing()) return;
+    this.refreshing.set(true);
+    this.runtime.refreshRuntime().pipe(takeUntilDestroyed(this.destroyRef), finalize(() => this.refreshing.set(false))).subscribe({
+      next: ok => {
+        this.refreshFailed.set(!ok);
+        this.outcome.set(ok ? 'languageManagement.applied' : 'languageManagement.storedRefreshFailed');
+      },
+      error: () => {
+        this.refreshFailed.set(true);
+        this.outcome.set('languageManagement.storedRefreshFailed');
+      },
+    });
+  }
+
+  private changeTexts(row: LanguageGridRow): void {
+    if (!this.actionBusy() && row.cultureCode && row.isActive) void this.router.navigate(['/Language/texts'], { queryParams: { targetLanguageCode: row.cultureCode } });
+  }
+
+  exportExcel(): void {
+    if (this.exportBlocked) return;
+    const query = this.currentQuery();
+    const labels = new Map<string, string>();
+    for (const column of this.columns) labels.set(column.header, this.translate.instant(column.header));
+    for (const key of ['mangeDetails.yes', 'mangeDetails.no', 'general.notAvailable']) labels.set(key, this.translate.instant(key));
+    const columns = [...this.columns];
+    this.exporting.set(true);
+    this.exportError.set('');
+    this.loading.startLoading();
+    this.service.getAllList(query).pipe(takeUntilDestroyed(this.destroyRef),
+      catchError(error => {
+        this.exportError.set(composedReadErrorMessage(error, 'language.errors.export'));
+        return of(null);
+      }),
+      finalize(() => {
+        this.exporting.set(false);
+        this.loading.endLoading();
+      }),
+    ).subscribe(rows => {
+      if (rows === null) return;
+      if (!rows.length) {
+        this.exportError.set(this.totalRecords() ? 'language.errors.export' : 'general.noDataFound');
+        return;
+      }
+      onExportToExcel(signal(dataTableExportRows(rows, columns, key => labels.get(key) ?? key)), 'Languages');
+    });
+  }
+
+  private restoreStateFromRoute(): void {
+    const state = readListRoute(this.activatedRoute);
+    const paging = state.paging();
+    this.filterForm.patchValue({ languageName: state.text('languageName') }, { emitEvent: false });
+    this.pageNo.set(paging.pageNo);
+    this.pageSize.set(Math.min(100, Math.max(10, paging.pageSize)));
+    if (paging.sortField && this.sortableFields.has(paging.sortField)) this.sortField.set(paging.sortField);
+    if (paging.sortOrder) this.sortOrder.set(paging.sortOrder);
+  }
+  private writeStateToRoute(): void {
+    writeListRoute(this.router, this.activatedRoute, { languageName: this.activeFilters.languageName,
+      pageNo: this.pageNo(), pageSize: this.pageSize(), sortField: this.sortField(), sortOrder: this.sortOrder() });
+  }
+
+  readonly actions: ActionList<LanguageGridRow>[] = [
+    { title: 'general.viewDetails', icon: 'bi bi-eye', disabled: () => this.actionBusy(), action: row => {
+      if (row) this.openEditor('view', row);
+    } },
+    { title: 'general.edit', icon: 'bi bi-pencil-square', visible: row => !!row && !row.isBuiltIn, disabled: () => this.actionBusy(), action: row => {
+      if (row) this.openEditor('edit', row);
+    } },
+    { title: 'languageManagement.changeTexts', icon: 'bi bi-translate', disabled: row => this.actionBusy() || !row?.cultureCode || !row.isActive, action: row => {
+      if (row) this.changeTexts(row);
+    } },
+    { title: 'languageManagement.setDefault', icon: 'bi bi-star', disabled: row => this.actionBusy() || !row?.cultureCode || !row.isActive || row.isDefault, action: row => {
+      if (row) this.chooseDefault(row);
+    } },
+    { title: 'general.delete', icon: 'bi bi-trash3', visible: row => !!row && !row.isBuiltIn, disabled: row => this.actionBusy() || !!row?.isDefault, action: row => {
+      if (row) this.confirmDelete(row);
+    } },
+  ];
 }
