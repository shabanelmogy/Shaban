+    {
+        var options = await GetOptionsAsync();
+        return new Results<DropdownDto>
+        {
+            IsSuccess = true,
+            Entities = options.Entity!.Languages.Select(x => new DropdownDto
+            {
+                Id = x.Id,
+                Value = x.LanguageName
+            })
+        };
+    }
