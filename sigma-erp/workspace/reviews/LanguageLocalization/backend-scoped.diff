+    public async Task<Result<LanguageOptionsVM>> GetOptionsAsync()
+    {
+        var rows = await RowsAsync();
+        var setting = await GetSettingsAsync();
+        // Built-in wins a legacy duplicate. Ambiguous custom identities stay visible in the list only.
+        var options = rows.Where(x => x.IsActive == true && x.CultureCode != null)
+            .GroupBy(x => x.CultureCode!, StringComparer.OrdinalIgnoreCase)
+            .Select(g => g.FirstOrDefault(x => x.IsBuiltIn) ?? (g.Count() == 1 ? g.Single() : null))
+            .Where(x => x != null)
+            .Select(x => new LanguageOptionVM
+            {
+                Id = x!.Id,
+                CultureCode = x.CultureCode!,
+                LanguageName = x.LanguageName,
+                Flag = x.Flag,
+                IsBuiltIn = x.IsBuiltIn,
+                IsDefault = x.IsDefault,
+                IsActive = true,
+                IsRightToLeft = CultureInfo.GetCultureInfo(x.CultureCode!).TextInfo.IsRightToLeft
+            }).ToList();
+        return new Result<LanguageOptionsVM>
+        {
+            IsSuccess = true,
+            Entity = new LanguageOptionsVM
+            {
+                Languages = options,
+                Sources = LocalizationRules.Sources,
+                DefaultLanguageCode = setting?.DefaultLanguageCode ?? "en",
+                SettingsVersion = LocalizationRules.Token(setting?.Version)
+            }
+        };
+    }
