+    public override Task<Result> AddAsync(LanguageAddVM vm, CancellationToken cancellationToken = default)
+        => UnitOfWork.ExecuteUniqueWriteAsync<Language>(async () =>
+        {
+            if (!Validator.TryValidateObject(vm, new ValidationContext(vm), [], true))
+                return BusinessFailure("LocalizationInvalidQuery");
+            var code = LocalizationRules.Culture(vm.CultureCode);
+            if (code == null)
+                return BusinessFailure("LanguageInvalidCulture");
+            if ((await RowsAsync()).Any(x => x.CultureCode == code))
+                return BusinessFailure("LanguageCultureExists");
+            vm.CultureCode = code;
+            return await base.AddAsync(vm, cancellationToken);
+        }, cancellationToken);
+
+    public override Task<Result> UpdateAsync(LanguageUpdateVM vm)
+        => UnitOfWork.ExecuteUniqueWriteAsync<Language>(async () =>
+        {
+            if (!Validator.TryValidateObject(vm, new ValidationContext(vm), [], true))
+                return BusinessFailure("LocalizationInvalidQuery");
+            if (vm.Id <= 0)
+                return BusinessFailure("LanguageBuiltInLocked");
+            var entity = await UnitOfWork.Repository.FindByIdAsync<Language>(vm.Id);
+            if (entity == null)
+                return BusinessFailure("LanguageNotFound", 404);
+            if (await InvalidInputAsync(vm, vm.Id) is { } invalid)
+                return invalid;
+            var oldCode = LocalizationRules.ResolveCode(entity.CultureCode, entity.LanguageName);
+            var code = LocalizationRules.Culture(vm.CultureCode);
+            if (code == null)
+                return BusinessFailure("LanguageInvalidCulture");
+            if (oldCode != code && await UsedAsync(oldCode))
+                return BusinessFailure("LanguageInUse");
+            if ((await RowsAsync()).Any(x => x.Id != vm.Id && x.CultureCode == code)
+                && oldCode != code)
+                return BusinessFailure("LanguageCultureExists");
+            if (await UnitOfWork.Repository.ExistsAsync<Language>(
+                x => x.Id != vm.Id && x.CultureCode == code))
+                return BusinessFailure("LanguageCultureExists");
+            // A changed legacy name must not silently change a resolved identity.
+            // Persist its existing identity when renaming, but never rewrite on read.
+            entity.LanguageName = vm.LanguageName;
+            entity.Flag = vm.Flag;
+            if (entity.CultureCode != null || oldCode != code
+                || LocalizationRules.ResolveCode(null, vm.LanguageName) != oldCode)
+                entity.CultureCode = code;
+            return await SaveUpdateAsync(entity, CancellationToken.None);
+        });
+
+    private async Task<bool> UsedAsync(string? code)
+        => code != null && (((await GetSettingsAsync())?.DefaultLanguageCode ?? "en") == code
+            || await UnitOfWork.Repository.ExistsAsync<LanguageTextOverride>(x => x.LanguageCode == code));
+
+    public override Task<Result> RemoveAsync(int id)
+        => UnitOfWork.ExecuteUniqueWriteAsync<Language>(async () =>
+        {
+            if (id <= 0)
+                return BusinessFailure("LanguageBuiltInLocked");
+            var entity = await UnitOfWork.Repository.FindByIdAsync<Language>(id);
+            if (entity == null)
+                return BusinessFailure("LanguageNotFound", 404);
+            if (await UsedAsync(LocalizationRules.ResolveCode(entity.CultureCode, entity.LanguageName)))
+                return BusinessFailure("LanguageInUse");
+            return await RemoveWithChildrenAsync(id, CancellationToken.None);
+        });
+
+    public Task<Result> SetDefaultAsync(LanguageDefaultVM vm)
+        => UnitOfWork.ExecuteUniqueWriteAsync<Language>(async () =>
+        {
+            var code = LocalizationRules.Culture(vm.CultureCode);
+            var options = await GetOptionsAsync();
+            if (code == null || !options.Entity!.Languages.Any(x => x.CultureCode == code))
+                return BusinessFailure("LanguageInvalidCulture");
+            var current = await GetSettingsAsync();
+            if (LocalizationRules.Token(current?.Version) != vm.ExpectedVersion)
+                return BusinessFailure("LocalizationConflict", 409);
+            vm.CultureCode = code;
+            await settings.UpsertSingleAsync<LanguageDefaultVM, LanguageSettings>(vm, CancellationToken.None);
+            try
+            {
+                var saved = await UnitOfWork.SaveChangesAsync();
+                return saved ? new Result { IsSuccess = true } : BusinessFailure("LocalizationConflict", 409);
+            }
+            catch (DbUpdateConcurrencyException)
+            {
+                return BusinessFailure("LocalizationConflict", 409);
+            }
+        });
+
