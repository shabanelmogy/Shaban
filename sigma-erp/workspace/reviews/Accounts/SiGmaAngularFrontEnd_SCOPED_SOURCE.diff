@@ -0,0 +1,26 @@
+import { HttpClient } from '@angular/common/http';
+import { inject } from '@angular/core';
+import { Observable } from 'rxjs';
+
+import { Result } from 'src/app/modules/shared/models/result';
+import { toFilterParams } from 'src/app/modules/shared/utils/list-query';
+import { environment } from 'src/environments/environment';
+
+export abstract class AccountReportEndpointService<
+  TFilter extends object,
+  TResponse extends object,
+> {
+  private readonly http = inject(HttpClient);
+  private readonly endpoint: string;
+
+  protected constructor(action: string) {
+    this.endpoint = `${environment.baseUrl}AccountReports/${action}`;
+  }
+
+  getReport(filter: TFilter): Observable<Result<TResponse>> {
+    return this.http.get<Result<TResponse>>(this.endpoint, {
+      params: toFilterParams(filter),
+      headers: { 'X-Skip-Error-Interceptor': 'true' },
+    });
+  }
+}

diff --git a/src/app/modules/Accounts/shared/report-family/account-report-page.component.html b/src/app/modules/Accounts/shared/report-family/account-report-page.component.html
