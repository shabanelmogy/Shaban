@@ -0,0 +1,33 @@
+import { HttpClient } from '@angular/common/http';
+import { inject } from '@angular/core';
+import { Observable } from 'rxjs';
+
+import { Result } from 'src/app/modules/shared/models/result';
+import { Results } from 'src/app/modules/shared/models/results';
+import { environment } from 'src/environments/environment';
+
+/** Feature-owned transport for full-replacement opening-balance collections. */
+export abstract class OpeningBalanceCollectionService {
+  private readonly http = inject(HttpClient);
+
+  protected constructor(private readonly resource: string) {}
+
+  getRows<TRow>(): Observable<Results<TRow>> {
+    return this.http.get<Results<TRow>>(`${environment.baseUrl}${this.resource}`, {
+      headers: { 'X-Skip-Error-Interceptor': 'true' },
+    });
+  }
+
+  saveRows<TItem>(expectedVersion: string, items: ReadonlyArray<TItem>): Observable<Result<unknown>> {
+    return this.http.post<Result<unknown>>(
+      `${environment.baseUrl}${this.resource}/AddList`,
+      { expectedVersion, items },
+      {
+        headers: {
+          'X-Skip-Error-Interceptor': 'true',
+          'X-Skip-Success-Toast': 'true',
+        },
+      },
+    );
+  }
+}

