   .sigma-filter-panel__toolbar { align-items: stretch; flex-direction: column; }
   .sigma-filter-panel__actions > * { flex: 1 1 auto; }
 }
+
+/* Simple search strips can share the control line with Reset (UI block 4). */
+.sigma-filter-panel.sigma-filter-panel--inline-actions {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto;
+  align-items: end;
+}
+
+.sigma-filter-panel--inline-actions > .sigma-filter-panel__grid {
+  grid-template-columns: repeat(var(--sigma-filter-main-columns, 6), minmax(0, 1fr));
+}
+
+.sigma-filter-panel--inline-actions > .sigma-filter-panel__toolbar {
+  flex-direction: row;
+}
+
+.sigma-filter-panel--inline-actions .sigma-filter-panel__toolbar-start:empty {
+  display: none;
+}
+
+@media (max-width: 720px) {
+  .sigma-filter-panel--inline-actions > .sigma-filter-panel__grid {
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
diff --git a/src/styles.scss b/src/styles.scss
