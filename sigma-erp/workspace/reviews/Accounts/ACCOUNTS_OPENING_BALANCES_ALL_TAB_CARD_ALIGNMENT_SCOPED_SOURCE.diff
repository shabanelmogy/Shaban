@@ -4401,6 +4407,78 @@ body.sigma-app-viewport .app-content:has(.sigma-route-host) {
 .sigma-editor-scroll > * { flex: 0 0 auto; }
 .sigma-editor-panel > app-feature-title { flex: 0 0 auto; }
 
+/* Shared three-pane record editor: Details / Jobs / selected Job details (UI 1, 13). */
+.sigma-editor-form--three-pane {
+  container: sigma-editor-workspace / inline-size;
+}
+
+.sigma-editor-body.sigma-editor-body--three-pane {
+  display: grid;
+  grid-template-columns: minmax(240px, 280px) minmax(170px, 200px) minmax(0, 1fr);
+  grid-template-rows: minmax(0, 1fr);
+}
+
+.sigma-editor-pane {
+  display: flex;
+  min-inline-size: 0;
+  min-block-size: 0;
+  flex-direction: column;
+  overflow: hidden;
+}
+
+.sigma-editor-pane > app-form-section { flex: 1 1 0; }
+.sigma-editor-grid.sigma-editor-pane-fields { grid-template-columns: minmax(0, 1fr); }
+
+/* Closed lookup text must shrink inside the three-pane editor's field width. */
+.sigma-editor-form--three-pane .sigma-field :is(p-dropdown, .p-dropdown) {
+  box-sizing: border-box;
+  min-width: 0;
+  width: 100%;
+  max-width: 100%;
+}
+
+.sigma-editor-form--three-pane .sigma-field .p-dropdown-label {
+  display: block;
+  min-width: 0;
+  flex: 1 1 auto;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.sigma-editor-form--three-pane .sigma-field .p-dropdown-trigger { flex-shrink: 0; }
+
+@container sigma-editor-workspace (max-width: 900px) {
+  .sigma-editor-body.sigma-editor-body--three-pane {
+    grid-template-columns: minmax(220px, 280px) minmax(0, 1fr);
+    grid-template-rows: minmax(120px, 0.35fr) minmax(0, 1fr);
+  }
+  .sigma-editor-pane--master { grid-column: 1; grid-row: 1 / 3; }
+  .sigma-editor-pane--jobs { grid-column: 2; grid-row: 1; }
+  .sigma-editor-pane--detail { grid-column: 2; grid-row: 2; }
+}
+
+@container sigma-editor-workspace (max-width: 620px) {
