+/* Tree/settings workspaces fill the panel content; align title/filter cards with that frame (UI block 3). */
+.sigma-list-panel--workspace > .sigma-list-header app-feature-title,
+.sigma-editor-panel--workspace > app-feature-title { margin-inline: 0; }
+.sigma-list-panel--workspace .sigma-filter-panel,
+.sigma-editor-panel--workspace .sigma-filter-panel { margin-inline: 0; }
