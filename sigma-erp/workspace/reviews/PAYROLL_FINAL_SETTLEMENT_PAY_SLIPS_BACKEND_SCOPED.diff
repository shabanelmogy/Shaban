using System.Globalization;
using System.Text.Json;
using SiGma.ViewModels.ViewModels.PayrollRun;
using SiGma.ViewModels.ViewModels.PaySlip;

namespace SiGma.Business.Services.Payrolls;

public sealed class PaySlipService : IPaySlipService
{
    private const string PayrollType = "Payroll";
    private const string LeaveSalaryType = "LeaveSalary";
    private const string FinalSettlementType = "FinalSettlement";
    private readonly IUnitOfWork<SiGmaDbContext> _unitOfWork;
    private readonly IStringLocalizer<GeneralMessage> _localization;

    public PaySlipService(IUnitOfWork<SiGmaDbContext> unitOfWork,
        IStringLocalizer<GeneralMessage> localization)
    {
        _unitOfWork = unitOfWork;
        _localization = localization;
    }

    public async Task<Results<PaySlipListVm>> ListAsync(ListSmBase request,
        CancellationToken cancellationToken = default)
    {
        var filters = request.Filters ?? [];
        var dateFrom = FilterHelper.GetDate(filters, "dateFrom");
        var dateTo = FilterHelper.GetDate(filters, "dateTo");
        var no = FilterHelper.GetString(filters, "no");
        var type = FilterHelper.GetString(filters, "type");
        var staffId = FilterHelper.GetInt(filters, "staffId");
        var sort = FilterHelper.GetString(filters, "sortField") ?? "date";
        var order = FilterHelper.GetInt(filters, "sortOrder") ?? -1;
        var noRunId = 0;
        var noRevision = 0;
        var noStaffId = 0;
        var validNo = no is null || TrySlipNo(no, out noRunId, out noRevision, out noStaffId);
        if (filters.ContainsKey("dateFrom") && !dateFrom.HasValue ||
            filters.ContainsKey("dateTo") && !dateTo.HasValue || dateFrom > dateTo ||
            type is not (null or PayrollType or LeaveSalaryType or FinalSettlementType) ||
            filters.ContainsKey("staffId") && staffId is not > 0 || !validNo ||
            sort is not ("date" or "no" or "name" or "code" or "type" or "totalAmount") ||
            order is not (1 or -1))
            return new() { Message = _localization["PaySlipFiltersInvalid"], Entities = [] };

        var query = from run in _unitOfWork.Repository.Query<PayrollRun>()
                    join revision in _unitOfWork.Repository.Query<PayrollRunRevision>()
                        on new { RunId = run.Id, Number = run.CurrentRevision }
                        equals new { RunId = revision.PayrollRunId, Number = revision.RevisionNumber }
                    join line in _unitOfWork.Repository.Query<PayrollLine>() on revision.Id equals line.PayrollRunRevisionId
                    select new
                    {
                        Id = line.Id, RunId = run.Id, revision.RevisionNumber, line.StaffId,
                        line.Name, line.Code,
                        Date = run.Type == FinalSettlementType
                            ? run.LastWorkingDay ?? run.PeriodEnd.AddDays(-1)
                            : run.PeriodEnd.AddDays(-1),
                        run.Type, TotalAmount = line.NetPay,
                        IsApproved = revision.ApprovedAt.HasValue,
                        IsPaid = run.IsPaid,
                        IsCurrentRevision = run.CurrentRevision == revision.RevisionNumber
                    };
        if (dateFrom.HasValue) query = query.Where(x => x.Date >= dateFrom.Value);
        if (dateTo.HasValue) query = query.Where(x => x.Date <= dateTo.Value);
        if (type is not null) query = query.Where(x => x.Type == type);
        if (staffId.HasValue) query = query.Where(x => x.StaffId == staffId.Value);
        if (no is not null)
            query = query.Where(x => x.RunId == noRunId && x.RevisionNumber == noRevision && x.StaffId == noStaffId);

        var total = await query.CountAsync(cancellationToken);
        var size = Math.Clamp(request.PageSize ?? 10, 1, 100);
        var pages = (int)Math.Ceiling(total / (double)size);
        var page = Math.Clamp(request.PageNo ?? 1, 1, Math.Max(1, pages));
        var ordered = (sort, order) switch
        {
            ("date", 1) => query.OrderBy(x => x.Date),
            ("name", 1) => query.OrderBy(x => x.Name),
            ("name", -1) => query.OrderByDescending(x => x.Name),
            ("code", 1) => query.OrderBy(x => x.Code),
            ("code", -1) => query.OrderByDescending(x => x.Code),
            ("type", 1) => query.OrderBy(x => x.Type),
            ("type", -1) => query.OrderByDescending(x => x.Type),
            ("totalAmount", 1) => query.OrderBy(x => x.TotalAmount),
            ("totalAmount", -1) => query.OrderByDescending(x => x.TotalAmount),
            ("no", 1) => query.OrderBy(x => x.RunId).ThenBy(x => x.RevisionNumber).ThenBy(x => x.StaffId),
            ("no", -1) => query.OrderByDescending(x => x.RunId).ThenByDescending(x => x.RevisionNumber)
                .ThenByDescending(x => x.StaffId),
            _ => query.OrderByDescending(x => x.Date)
        };
        var rows = await ordered.ThenBy(x => x.Id).AsNoTracking()
            .Skip((page - 1) * size).Take(size).ToListAsync(cancellationToken);
        return new()
        {
            IsSuccess = true, PageNo = page, PageSize = size, TotalCount = total, TotalPages = pages,
            Entities = rows.Select(x => new PaySlipListVm
            {
                Id = x.Id, RunId = x.RunId, RevisionNumber = x.RevisionNumber, StaffId = x.StaffId,
                No = SlipNo(x.RunId, x.RevisionNumber, x.StaffId), Name = x.Name, Code = x.Code,
                Date = x.Date, Type = x.Type, TotalAmount = x.TotalAmount,
                IsApproved = x.IsApproved, IsPaid = x.IsPaid, IsCurrentRevision = x.IsCurrentRevision
            }).ToList()
        };
    }

    public async Task<Result<PaySlipDetailVm>> GetAsync(int id,
        CancellationToken cancellationToken = default)
    {
        var row = await (from line in _unitOfWork.Repository.Query<PayrollLine>(x => x.Id == id)
                         join revision in _unitOfWork.Repository.Query<PayrollRunRevision>()
                             on line.PayrollRunRevisionId equals revision.Id
                         join run in _unitOfWork.Repository.Query<PayrollRun>()
                             on revision.PayrollRunId equals run.Id
                         select new
                         {
                             Line = line, Revision = revision, Run = run,
                             Date = run.Type == FinalSettlementType
                                 ? run.LastWorkingDay ?? run.PeriodEnd.AddDays(-1)
                                 : run.PeriodEnd.AddDays(-1)
                         }).AsNoTracking().SingleOrDefaultAsync(cancellationToken);
        if (row is null)
            return new() { Message = _localization["PaySlipNotFound"], ErrorStatusCode = 404 };
        var settlement = DeserializeSettlement(row.Revision.SettlementSnapshot);
        if (row.Run.Type == FinalSettlementType && settlement is null)
            return new() { Message = _localization["PayrollHistoryInvalid"], ErrorStatusCode = 409 };
        return new()
        {
            IsSuccess = true,
            Entity = new PaySlipDetailVm
            {
                Id = row.Line.Id, RunId = row.Run.Id, RevisionNumber = row.Revision.RevisionNumber,
                StaffId = row.Line.StaffId,
                No = SlipNo(row.Run.Id, row.Revision.RevisionNumber, row.Line.StaffId),
                Name = row.Line.Name, Code = row.Line.Code, Date = row.Date, Type = row.Run.Type,
                TotalAmount = row.Line.NetPay, IsApproved = row.Revision.ApprovedAt.HasValue,
                IsPaid = row.Run.IsPaid && row.Run.CurrentRevision == row.Revision.RevisionNumber,
                IsCurrentRevision = row.Run.CurrentRevision == row.Revision.RevisionNumber,
                Period = row.Run.PeriodStart.ToString("yyyy-MM", CultureInfo.InvariantCulture),
                OvertimePeriod = row.Revision.OvertimePeriod.ToString("yyyy-MM", CultureInfo.InvariantCulture),
                PolicyVersion = row.Revision.PolicyVersion, DecimalPlaces = row.Revision.DecimalPlaces,
                Basic = row.Line.Basic, Allowances = row.Line.Allowances, Gross = row.Line.Gross,
                Overtime = row.Line.Overtime, Additional = row.Line.Additional,
                Deductions = row.Line.Deductions, NetPay = row.Line.NetPay,
                FinalSettlement = settlement
            }
        };
    }

    public async Task<Results<PaySlipStaffOptionVm>> StaffAsync(
        CancellationToken cancellationToken = default)
    {
        var rows = await (from line in _unitOfWork.Repository.Query<PayrollLine>()
                          join revision in _unitOfWork.Repository.Query<PayrollRunRevision>()
                              on line.PayrollRunRevisionId equals revision.Id
                          join run in _unitOfWork.Repository.Query<PayrollRun>()
                              on revision.PayrollRunId equals run.Id
                          orderby line.Id descending
                          select new { line.Id, line.StaffId, line.Code, line.Name })
            .AsNoTracking().ToListAsync(cancellationToken);
        var options = rows.GroupBy(x => x.StaffId).Select(group => group.First())
            .OrderBy(x => x.Code).ThenBy(x => x.StaffId)
            .Select(x => new PaySlipStaffOptionVm
            { Id = x.StaffId, No = x.Code, Value = x.Name }).ToList();
        return new() { IsSuccess = true, Entities = options };
    }

    private static string SlipNo(int runId, int revisionNumber, int staffId)
        => FormattableString.Invariant($"{runId}-{revisionNumber}-{staffId}");

    private static bool TrySlipNo(string value, out int runId, out int revisionNumber, out int staffId)
    {
        runId = revisionNumber = staffId = 0;
        var parts = value.Split('-', StringSplitOptions.None);
        return parts.Length == 3 && int.TryParse(parts[0], NumberStyles.None, CultureInfo.InvariantCulture, out runId) &&
            int.TryParse(parts[1], NumberStyles.None, CultureInfo.InvariantCulture, out revisionNumber) &&
            int.TryParse(parts[2], NumberStyles.None, CultureInfo.InvariantCulture, out staffId) &&
            runId > 0 && revisionNumber > 0 && staffId > 0;
    }

    private static FinalSettlementSnapshotVm? DeserializeSettlement(string? snapshot)
    {
        if (string.IsNullOrWhiteSpace(snapshot)) return null;
        try
        {
            var value = JsonSerializer.Deserialize<FinalSettlementSnapshotVm>(snapshot);
            return IsValidSettlementSnapshot(value) ? value : null;
        }
        catch (JsonException) { return null; }
    }

    private static bool IsValidSettlementSnapshot(FinalSettlementSnapshotVm? value)
        => value?.Inputs is not null && value.SalaryDivisor > 0 && value.SalaryDays >= 0 &&
            value.ServiceDays > 0 && TryDate(value.FirstWorkingDay) && TryDate(value.NormalSalaryFrom) &&
            TryDate(value.LastWorkingDay) && TryDate(value.Inputs.LastWorkingDay) &&
            TryDate(value.Inputs.JoiningOrRejoiningDate) &&
            value.Inputs.SalaryProrationBasis is "CalendarDays" or "Fixed30" &&
            value.Inputs.LeaveSalaryBasis is "Basic" or "Gross" &&
            value.Inputs.GratuitySalaryBasis is "Basic" or "Gross" &&
            value.Inputs.LeaveDaysRemaining.HasValue && value.Inputs.TicketQuota.HasValue &&
            value.Inputs.TicketQuotaPeriodYears.HasValue && value.Inputs.TicketPrice.HasValue &&
            value.Inputs.TicketEligibilityPercent.HasValue && value.Inputs.GratuityDays.HasValue;

    private static bool TryDate(string? value)
        => DateTime.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture,
            DateTimeStyles.None, out _);
}

